<Window
    x:Class="NoteIt.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:NoteIt"
    xmlns:ws="using:Windows.Storage"
    mc:Ignorable="d">

    <!-- =================== ROOT LAYOUT: TitleBar / Content / Footer =================== -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- row 0: custom title bar -->
            <RowDefinition Height="*"/>
            <!-- row 1: app content -->
            <RowDefinition Height="Auto"/>
            <!-- row 2: footer / transport -->
        </Grid.RowDefinitions>

        <!-- =================== SHARED RESOURCES / BRAND STYLES =================== -->
        <Grid.Resources>
            <!-- Brand palette -->
            <Color x:Key="BrandBlack">#111215</Color>
            <Color x:Key="BrandBlue">#7EC7FF</Color>
            <Color x:Key="BrandBlueDark">#4BADEB</Color>
            <Color x:Key="BrandText">#F5F9FF</Color>
            <Color x:Key="BrandSubtle">#22262B</Color>

            <SolidColorBrush x:Key="BrandBlackBrush" Color="{StaticResource BrandBlack}"/>
            <SolidColorBrush x:Key="BrandBlueBrush"  Color="{StaticResource BrandBlue}"/>
            <SolidColorBrush x:Key="BrandTextBrush"  Color="{StaticResource BrandText}"/>
            <SolidColorBrush x:Key="BrandSubtleBrush" Color="{StaticResource BrandSubtle}"/>

            <Style x:Key="FooterButton" TargetType="Button">
                <!-- Layout / shape -->
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinWidth" Value="90"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderThickness" Value="2"/>

                <!-- Base colors -->
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#7EC7FF"/>

            </Style>



            <!-- Footer text defaults -->
            <Style x:Key="FooterText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Slider accent in footer -->
            <Style x:Key="FooterSlider" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
            </Style>
        </Grid.Resources>

        <!-- =================== ROW 0: CUSTOM TITLE BAR (DRAG REGION) =================== -->
        <Grid x:Name="TitleBar"
              Height="36"
              Background="#121519"   
              VerticalAlignment="Top"
              Padding="10,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- App icon -->
            <Image Source="Assets/TitleBarIcon.png"
                   Width="20" Height="20"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>

            <!-- Title -->
            <TextBlock Grid.Column="1"
                       Text="NoteIt"
                       Foreground="{StaticResource BrandTextBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- =================== ROW 1: APP CONTENT =================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- toolbar -->
                <RowDefinition Height="*"/>
                <!-- pages -->
            </Grid.RowDefinitions>

            <!-- === Top toolbar (Choose Folder / View / Search / Vol) === -->
            <Grid Grid.Row="0"
                  Padding="8"
                  ColumnDefinitions="Auto,12,Auto,12,*,12,Auto,200">
                <Button x:Name="ChooseFolderButton"
                        Grid.Column="0"
                        Content="Choose Folder..."
                        Click="ChooseFolderButton_Click"/>

                <ComboBox x:Name="ViewPicker"
                          Grid.Column="2"
                          Width="140"
                          SelectedIndex="0"
                          SelectionChanged="ViewPicker_SelectionChanged">
                    <ComboBoxItem Content="All Songs"/>
                    <ComboBoxItem Content="Playlists"/>
                </ComboBox>

                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Column="4"
                                PlaceholderText="Search songs..."
                                TextChanged="SearchBox_TextChanged"/>

                <TextBlock Grid.Column="6"
                           Text="Vol"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
                <Slider x:Name="VolumeSlider"
                    Grid.Column="7"
                    Value="100" Minimum="0" Maximum="100"
                    HorizontalAlignment="Stretch"
                    ValueChanged="VolumeSlider_ValueChanged">
                    <Slider.Resources>
                        <SolidColorBrush x:Key="SliderTrackValueFill"   Color="#7EC7FF"/>
                        <SolidColorBrush x:Key="SliderTrackFill"        Color="#2A2E34"/>
                        <SolidColorBrush x:Key="SliderThumbBackground"  Color="#7EC7FF"/>
                        <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#7EC7FF"/>
                    </Slider.Resources>
                </Slider>

            </Grid>

            <!-- === Main pages (All Songs / Playlists / Detail) === -->
            <Grid Grid.Row="1" Padding="8">

                <!-- All songs -->
                <Grid x:Name="AllSongsPanel" Visibility="Visible">
                    <ListView x:Name="TracksListView"
                              IsItemClickEnabled="True"
                              SelectionMode="Single"
                              ItemClick="AnyList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="ws:StorageFile">
                                <Grid Background="Transparent" MinHeight="40" Padding="12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Button x:Name="MoreBtn"
                                            Grid.Column="1"
                                            Width="28" Height="28"
                                            Opacity="1"
                                            Padding="0"
                                            Margin="8,0,8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="⋯">
                                        <Button.Flyout>
                                            <MenuFlyout Opening="AllSongsFlyout_Opening">
                                                <MenuFlyoutSubItem x:Name="AddToOtherMenu"
                                                                   Text="Add to playlist"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem x:Name="QueueAddMenu"
                                                                Text="Add to queue"
                                                                Click="AddToQueue_Click"/>
                                                <MenuFlyoutItem x:Name="ViewQueueMenu"
                                                                Text="View queue"
                                                                Click="ViewQueue_Click"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Playlists overview -->
                <Grid x:Name="PlaylistsPanel" Visibility="Collapsed" RowDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="+ Create playlist" Click="CreatePlaylist_Click"/>
                    </StackPanel>
                    <ListView x:Name="PlaylistsList"
                              Grid.Row="1"
                              IsItemClickEnabled="True"
                              ItemClick="PlaylistsList_ItemClick"
                              ItemsSource="{x:Bind _playlists, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlaylistInfo">
                                <Grid MinHeight="38" Padding="8,4,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Button Grid.Column="1"
                                            Content="⋯"
                                            Width="32" Height="28"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Rename playlist…" Tag="{Binding}" Click="RenamePlaylist_Click"/>
                                                <MenuFlyoutItem Text="Delete playlist"  Tag="{Binding}" Click="DeletePlaylist_Click"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Playlist detail -->
                <Grid x:Name="PlaylistDetailPanel" Visibility="Collapsed" RowDefinitions="Auto,Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="← Back" Click="BackFromPlaylist_Click"/>
                        <TextBlock x:Name="PlaylistTitleText" FontSize="20" VerticalAlignment="Center"/>
                        <Button Content="Add songs" Margin="16,0,0,0" Click="AddSongs_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="DetailStatusText" Grid.Row="1" Margin="0,0,0,8"/>

                    <ListView x:Name="PlaylistTracksList"
                              Grid.Row="2"
                              IsItemClickEnabled="True"
                              ItemClick="AnyList_ItemClick"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="ws:StorageFile">
                                <Grid Background="Transparent" MinHeight="40" Padding="12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Button x:Name="MoreBtn"
                                            Grid.Column="1"
                                            Width="28" Height="28"
                                            Opacity="1"
                                            Padding="0"
                                            Margin="8,0,8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="⋯">
                                        <Button.Flyout>
                                            <MenuFlyout Opening="MoreFlyout_Opening">
                                                <MenuFlyoutItem x:Name="RemoveThisMenu"
                                                                Text="Remove from this playlist"
                                                                Click="RemoveFromThisPlaylist_Click"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutSubItem x:Name="AddToOtherMenu"
                                                                   Text="Add to other playlist"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem x:Name="QueueAddMenu"
                                                                Text="Add to queue"
                                                                Click="AddToQueue_Click"/>
                                                <MenuFlyoutItem x:Name="ViewQueueMenu"
                                                                Text="View queue"
                                                                Click="ViewQueue_Click"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- =================== ROW 2: FOOTER / TRANSPORT (BLACK + BLUE) =================== -->
        <Grid Grid.Row="2" Padding="10,8" Background="{StaticResource BrandBlackBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- times + slider -->
                <RowDefinition Height="Auto"/>
                <!-- marquee + transport -->
            </Grid.RowDefinitions>

            <!-- Row 0: times + slider -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="CurrentTimeText"
             Grid.Column="0"
             Style="{StaticResource FooterText}" Text="00:00"/>

                <!-- change from /> to > and add </Slider> after Resources -->
                <Slider x:Name="PositionSlider"
          Grid.Column="1"
          Style="{StaticResource FooterSlider}"
          Minimum="0" Maximum="1000"
          Tapped="PositionSlider_Tapped"
          PointerPressed="PositionSlider_PointerPressed"
          PointerMoved="PositionSlider_PointerMoved"
          PointerReleased="PositionSlider_PointerReleased"
          PointerCanceled="PositionSlider_PointerCanceled"
          ValueChanged="PositionSlider_ValueChanged">

                    <Slider.Resources>
                        <SolidColorBrush x:Key="SliderTrackValueFill"  Color="#7EC7FF"/>
                        <SolidColorBrush x:Key="SliderTrackFill"       Color="#2A2E34"/>
                        <SolidColorBrush x:Key="SliderThumbBackground" Color="#7EC7FF"/>
                        <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#7EC7FF"/>
                    </Slider.Resources>

                </Slider>

                <TextBlock x:Name="DurationText"
             Grid.Column="2"
             Style="{StaticResource FooterText}" Text="00:00"/>
            </Grid>

            <!-- Row 1: marquee (left) + transport buttons (right) -->
            <Grid Grid.Row="1" ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Now playing marquee -->
                <ScrollViewer x:Name="NowPlayingScroller"
                              Grid.Column="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              IsHitTestVisible="False">
                    <StackPanel x:Name="NowPlayingStack" Orientation="Horizontal" Spacing="24">
                        <TextBlock x:Name="NowPlayingText1" Style="{StaticResource FooterText}" FontSize="12" TextTrimming="Clip"/>
                        <TextBlock x:Name="NowPlayingText2" Style="{StaticResource FooterText}" FontSize="12" TextTrimming="Clip" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Transport buttons -->
                <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">

                    <!-- Prev -->
                    <Button x:Name="PrevButton"
            Style="{StaticResource FooterButton}"
            Click="PrevButton_Click">
                        <Button.Resources>
                            <!-- Normal -->
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>

                            <!-- Hover -->
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>

                            <!-- Pressed -->
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#61B6EE"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#61B6EE"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>

                            <!-- Disabled (optional) -->
                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#88FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#22000000"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#33555555"/>
                        </Button.Resources>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="⏮"/>
                            <TextBlock Text="Prev"/>
                        </StackPanel>
                    </Button>

                    <!-- Play / Pause -->
                    <Button x:Name="PlayPauseButton"
            Style="{StaticResource FooterButton}"
            Click="PlayPauseButton_Click">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>

                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>

                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#61B6EE"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#61B6EE"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>

                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#88FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#22000000"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#33555555"/>
                        </Button.Resources>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="▶"/>
                            <TextBlock Text="Play"/>
                        </StackPanel>
                    </Button>

                    <!-- Next -->
                    <Button x:Name="NextButton"
            Style="{StaticResource FooterButton}"
            Click="NextButton_Click">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>

                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>

                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#61B6EE"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#61B6EE"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>

                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#88FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#22000000"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#33555555"/>
                        </Button.Resources>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="⏭"/>
                            <TextBlock Text="Next"/>
                        </StackPanel>
                    </Button>

                    <!-- Shuffle -->
                    <Button x:Name="ShuffleButton"
            Style="{StaticResource FooterButton}"
            MinWidth="130"
            Click="ShuffleButton_Click">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>

                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#7EC7FF"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>

                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#61B6EE"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#61B6EE"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>

                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#88FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#22000000"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#33555555"/>
                        </Button.Resources>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🔀"/>
                            <TextBlock Text="Shuffle Off"/>
                        </StackPanel>
                    </Button>
                </StackPanel>


            </Grid>

            <!-- Optional status text (kept hidden) -->
            <TextBlock x:Name="StatusText" Grid.RowSpan="2" Margin="0,70,0,0" Visibility="Collapsed"/>
        </Grid>

    </Grid>
</Window>
